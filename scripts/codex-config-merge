#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["tomlkit>=0.13,<1.0"]
# ///
"""Merge the shared Codex settings into this machine's ~/.codex/config.toml.

Codex writes into its own config at runtime -- trusted projects, TUI counters,
model-migration notices, hook hashes -- so the file can never be a symlink into
a dotfiles repo, and copying a tracked file over it would throw that state away.
It also means the live file can hold secrets (an MCP bearer token, say), so it
must never be copied in the other direction into a public repo either.

This merges instead: every key the shared config defines is applied, every key
it does not mention keeps its current value, and tomlkit preserves the comments
and ordering already in the file rather than regenerating it from a dict.

Usage:
  codex-config-merge [--dry-run] [--shared PATH] [--overlay PATH] [--target PATH]

  --dry-run   print a unified diff and write nothing
  --shared    shared settings (default: ../config/codex/config.toml beside this
              script, i.e. the public dotfiles copy)
  --overlay   machine-local settings applied after the shared ones, for a host
              that needs more than the fleet (the private repo's copy).
              A missing overlay is not an error.
  --target    config to merge into (default: $CODEX_HOME/config.toml, else
              ~/.codex/config.toml)
"""

from __future__ import annotations

import argparse
import copy
import difflib
import os
import sys
from collections.abc import Mapping
from pathlib import Path

import tomlkit


def is_table(value: object) -> bool:
    """True for a TOML table. tomlkit's inline tables are Mappings too, but
    those live inside arrays and are assigned wholesale, never merged."""
    return isinstance(value, Mapping) and not isinstance(value, tomlkit.items.InlineTable)


def apply(target, source) -> None:
    """Apply source over target in place, recursing into tables so a key the
    source never mentions survives."""
    for key, value in source.items():
        if is_table(value):
            if not is_table(target.get(key)):
                # A table holding only tables is a super table: it renders as
                # [a.b] alone rather than an empty [a] header above it.
                target[key] = tomlkit.table(
                    is_super_table=all(is_table(v) for v in value.values()) and bool(value)
                )
            apply(target[key], value)
        else:
            target[key] = copy.deepcopy(value)


def blank_line_before_tables(text: str) -> str:
    """Put one blank line before every table header. A table inserted next to
    existing siblings otherwise renders flush against whatever follows it,
    which is valid TOML but unreadable. Purely cosmetic: the result is
    re-parsed and compared before it is written."""
    out: list[str] = []
    for line in text.splitlines(keepends=True):
        blank = line.strip() == ""
        if blank and (not out or out[-1].strip() == ""):
            continue  # collapse runs of blank lines, and drop a leading one
        if (line.lstrip().startswith("[")
                and not line.lstrip().startswith("[[")
                and out and out[-1].strip() != ""):
            out.append("\n")
        out.append(line)
    return "".join(out)


def main() -> int:
    here = Path(__file__).resolve().parent
    codex_home = os.environ.get("CODEX_HOME") or str(Path.home() / ".codex")

    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--shared", default=str(here.parent / "config/codex/config.toml"))
    parser.add_argument("--overlay", default="")
    parser.add_argument("--target", default=str(Path(codex_home) / "config.toml"))
    args = parser.parse_args()

    shared_path = Path(args.shared).expanduser()
    target_path = Path(args.target).expanduser()

    if not shared_path.is_file():
        print(f"ERROR: shared config not found: {shared_path}", file=sys.stderr)
        return 1

    sources = [shared_path]
    if args.overlay:
        overlay_path = Path(args.overlay).expanduser()
        if overlay_path.is_file():
            sources.append(overlay_path)

    if target_path.is_file():
        original = target_path.read_text()
    else:
        original = ""

    try:
        doc = tomlkit.parse(original)
    except Exception as exc:
        print(f"ERROR: {target_path} is not valid TOML: {exc}", file=sys.stderr)
        return 1

    for source_path in sources:
        try:
            apply(doc, tomlkit.parse(source_path.read_text()))
        except Exception as exc:
            print(f"ERROR: {source_path}: {exc}", file=sys.stderr)
            return 1

    rendered = blank_line_before_tables(tomlkit.dumps(doc))

    # Never hand Codex a file we cannot read back as the thing we meant.
    expected = doc.unwrap()
    if tomlkit.parse(rendered).unwrap() != expected:
        print("ERROR: output does not round-trip; refusing to write", file=sys.stderr)
        return 1

    # Every key the sources set must actually be in the result.
    def verify(result, source, path=""):
        for key, value in source.items():
            where = f"{path}{key}"
            if key not in result:
                raise AssertionError(f"{where} missing from merged output")
            if isinstance(value, Mapping) and isinstance(result[key], Mapping):
                verify(result[key], value, f"{where}.")
            elif result[key] != value:
                raise AssertionError(f"{where} not applied: {result[key]!r} != {value!r}")

    try:
        for source_path in sources:
            verify(expected, tomlkit.parse(source_path.read_text()).unwrap())
    except AssertionError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1

    if rendered == original:
        print(f"{target_path}: already up to date")
        return 0

    if args.dry_run:
        sys.stdout.writelines(difflib.unified_diff(
            original.splitlines(keepends=True),
            rendered.splitlines(keepends=True),
            fromfile=f"{target_path} (current)",
            tofile=f"{target_path} (merged)",
        ))
        return 0

    target_path.parent.mkdir(parents=True, exist_ok=True)
    mode = target_path.stat().st_mode & 0o777 if target_path.exists() else 0o600

    if original:
        backup = target_path.with_name(f"{target_path.name}.bak-{os.getpid()}")
        backup.write_text(original)
        os.chmod(backup, mode)
        print(f"  backup: {backup}")

    temp = target_path.with_name(f"{target_path.name}.tmp-{os.getpid()}")
    temp.write_text(rendered)
    os.chmod(temp, mode)
    temp.replace(target_path)

    changed = sum(1 for line in difflib.unified_diff(
        original.splitlines(), rendered.splitlines())
        if line.startswith(("+", "-")) and not line.startswith(("+++", "---")))
    print(f"{target_path}: merged shared Codex settings ({changed} lines changed)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
