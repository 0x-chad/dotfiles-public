#!/usr/bin/env python3
"""Curate which agents herdr manages today.

Every agent keeps running in tmux regardless. This only decides which ones
get a herdr tab, so a board of 30+ agents can be narrowed to the handful you
are actually working on.

  herdr-focus.py                          # show the current working set
  herdr-focus.py audit stx-783 raptor     # make that the working set
  herdr-focus.py --add stx-891            # add without dropping the rest
  herdr-focus.py --drop audit             # remove just these
  herdr-focus.py --clear                  # empty the board
  herdr-focus.py --all                    # every window in the session

Promote  = grouped tmux session pinned to one window + an hc terminal
           attached to it + a herdr.space label, which is what makes it
           visible in the app.
Demote   = close the tab. That ends only the `tmux attach` client; the agent
           and its window are untouched.

Runs on the machine with the herdr app; the agents may be anywhere.
"""
import argparse
import json
import os
import subprocess
import sys

# Names the single-window view sessions that back herdr tabs, by tmux window
# id: "herdr-view-129" for window @129, the "@" dropped because hc names allow
# only a-z 0-9 - _ . while tmux forbids ":" and ".", so this spelling is legal
# in both. The id rather than the name, because a window linked
# into a view belongs to both sessions, so muxlight (running in the pane)
# cannot tell which session owns it, and because window names change under
# automatic-rename while ids do not. Not settable: muxlight's internal/herdr
# has the same constant, and a mismatch fails silently because its report
# errors are ignored. Change it in both places.
PREFIX = "herdr-view-"

BIN = os.path.expanduser("~/.local/bin")
ENV = dict(os.environ, PATH=BIN + ":" + os.environ.get("PATH", ""))


def run(*argv, check=False):
    p = subprocess.run(list(argv), capture_output=True, text=True, env=ENV)
    if check and p.returncode != 0:
        sys.exit("%s failed: %s" % (argv[0], (p.stderr or p.stdout).strip()[:300]))
    return p.stdout


def jrun(*argv):
    out = run(*argv)
    try:
        return json.loads(out)
    except Exception:
        return {}


def ssh(machine, script):
    return subprocess.run(["ssh", machine, "bash", "-s"], input=script,
                          capture_output=True, text=True).stdout


_HOMES = {}


def home(machine):
    """The target machine's home directory, asked once per run.

    Machines differ (/home/ubuntu, /home/gman, /Users/...), so this cannot be
    assumed. Only used as the launch folder for the view terminal, which
    immediately execs tmux, so an empty answer is harmless.
    """
    if machine not in _HOMES:
        _HOMES[machine] = ssh(machine, "printf %s \"$HOME\"\n").strip()
    return _HOMES[machine]


def windows(machine, session):
    """[(index, name, window_id)] for the session, in tmux order."""
    out = ssh(machine, "tmux list-windows -t %s -F "
                       "'#{window_index}\t#{window_name}\t#{window_id}'\n" % session)
    rows = []
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) == 3:
            rows.append((parts[0], parts[1], parts[2]))  # index, name, @id
    return rows


def view(wid):
    """View/terminal name for a tmux window id: "@129" -> "herdr-view-129"."""
    return PREFIX + wid.lstrip("@")


def space(name):
    for s in jrun("herdr-app", "ls").get("spaces", []):
        if s.get("name") == name:
            return s
    return None


def terminals():
    return {t["address"]: t.get("name") for t in jrun("hc", "ls", "--json").get("terminals", [])}


def current(space_obj, names):
    """Map window_id -> tab object, for tabs backed by a view terminal."""
    out = {}
    for tab in (space_obj or {}).get("tabs", []):
        for t in tab.get("terminals", []):
            n = names.get(t["terminal"]) or ""
            if n.startswith(PREFIX):
                out["@" + n[len(PREFIX):]] = tab
    return out


def promote(machine, session, space_id, wid, win):
    """Give `win` its own single-window view session, and a herdr tab on it.

    A view is a session holding one linked window, not a session group. A
    group would carry every window of `session` into every view, so N views
    of M windows cost N*M session-to-window references; tooling that counts
    `tmux list-windows -a` rows then sees far more windows than exist. A
    linked view costs one reference. The window object is shared either way,
    so the agent is untouched, and each session keeps its own current window.
    """
    ssh(machine, (
        "s='%(p)s%(w)s'\n"
        "if ! tmux has-session -t \"$s\" 2>/dev/null; then\n"
        # Keep the placeholder's id: a name is ambiguous with an index in a
        # tmux window target, which is how "session:7" can mean window 7.
        "  ph=$(tmux new-session -d -s \"$s\" -n __view_placeholder "
        "-P -F '#{window_id}')\n"
        "  tmux link-window -s '%(src)s' -t \"$s:90\" 2>/dev/null\n"
        "  [ -n \"$ph\" ] && tmux kill-window -t \"$ph\" 2>/dev/null\n"
        "fi\n"
    ) % {"p": "", "w": view(wid), "src": wid})
    argv = ["hc", "run", "--bg", "--on", machine, "--name", view(wid)]
    cwd = ssh(machine, "tmux display-message -p -t '%s' '#{pane_current_path}'\n" % wid).strip()
    if not cwd:
        cwd = home(machine)
    if cwd:
        argv += ["--cwd", cwd]
    run(*(argv + ["tmux", "attach", "-t", view(wid)]))
    run("hc", "label", "%s/%s" % (machine, view(wid)), "herdr.space=" + space_id)
    seed(machine, wid)


def seed(machine, wid):
    """Publish the agent's current status once.

    muxlight only reports on a change, so a promoted agent would show nothing
    until its next transition. Read what muxlight already stored on the pane
    and send that, so a tab is correct the moment it appears.
    """
    out = ssh(machine, (
        "tmux list-panes -t '%(w)s' "
        "-F '#{@pst_state}|#{@pst_kind}|#{@pst_app}' 2>/dev/null | head -1\n"
    ) % {"w": wid}).strip()
    if not out:
        return
    state, _, rest = out.partition("|")
    kind, _, app = rest.partition("|")
    if not state:
        return
    body = "state=" + state
    if kind:
        body += ":kind=" + kind
    if app:
        body += ":app=" + app
    ssh(machine, "~/.local/bin/hc report '%s' --terminal '%s' >/dev/null 2>&1; true\n"
        % (body, view(wid)))


def rename(tab_id, name):
    run("herdr-app", "do", "tab.rename", "--id", tab_id, "--name", name)


def demote(machine, tab, wid):
    run("herdr-app", "do", "tab.close", "--id", tab["id"], "--confirmed", "true")
    ssh(machine, "tmux kill-session -t '%s' 2>/dev/null; true\n" % view(wid))


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("names", nargs="*", help="tmux window names to manage")
    # No host or session name is baked in: export HERDR_FOCUS_MACHINE and
    # HERDR_FOCUS_SESSION from your machine-local shell config instead.
    ap.add_argument("--machine", default=os.environ.get("HERDR_FOCUS_MACHINE", ""),
                    help="ssh host running tmux [$HERDR_FOCUS_MACHINE]")
    ap.add_argument("--session", default=os.environ.get("HERDR_FOCUS_SESSION", ""),
                    help="tmux session holding the agents [$HERDR_FOCUS_SESSION]")
    ap.add_argument("--space", help="herdr space name (default: same as --session)")
    ap.add_argument("--add", action="store_true", help="add to the set instead of replacing it")
    ap.add_argument("--drop", action="store_true", help="remove these from the set")
    ap.add_argument("--clear", action="store_true", help="remove everything from the set")
    ap.add_argument("--all", action="store_true", help="manage every window in the session")
    a = ap.parse_args()
    for flag, env in (("--machine", "HERDR_FOCUS_MACHINE"),
                      ("--session", "HERDR_FOCUS_SESSION")):
        if not getattr(a, flag.lstrip("-")):
            sys.exit("%s is required: pass it, or export %s in your "
                     "machine-local shell config." % (flag, env))
    space_name = a.space or a.session

    sp = space(space_name)
    if sp is None:
        sys.exit("no herdr space named %r. Create it with:\n"
                 "  herdr-app do space.new --name %s --machine %s --folder <path>"
                 % (space_name, space_name, a.machine))
    space_id = sp["id"].split("/", 1)[-1]

    # Identity is the window id; the name is only for you to type and read.
    wins = windows(a.machine, a.session)
    label = {wid: name for _, name, wid in wins}
    ids_for = {}
    for _, name, wid in wins:
        ids_for.setdefault(name, []).append(wid)
    have = current(sp, terminals())          # window_id -> tab

    if not (a.names or a.add or a.drop or a.clear or a.all):
        print("space %-10s  %d of %d windows managed" % (space_name, len(have), len(wins)))
        for _, name, wid in wins:
            print("  %s %s" % ("*" if wid in have else " ", name))
        return

    def resolve(names):
        """Window names -> ids, rejecting anything unknown or ambiguous."""
        out, bad, dupe = set(), [], []
        for n in names:
            got = ids_for.get(n) or []
            if not got:
                bad.append(n)
            elif len(got) > 1:
                dupe.append(n)
            else:
                out.add(got[0])
        if bad:
            sys.exit("not windows in %s:%s: %s"
                     % (a.machine, a.session, ", ".join(sorted(bad))))
        if dupe:
            sys.exit("ambiguous window name(s) in %s:%s: %s"
                     % (a.machine, a.session, ", ".join(sorted(dupe))))
        return out

    if a.all:
        want = set(label)
    elif a.clear:
        want = set()
    elif a.add:
        want = set(have) | resolve(a.names)
    elif a.drop:
        want = set(have) - resolve(a.names)
    else:
        want = resolve(a.names)

    for wid in sorted(want - set(have), key=lambda w: label.get(w, w)):
        promote(a.machine, a.session, space_id, wid, label.get(wid, wid))
        print("  + %s" % label.get(wid, wid))
    for wid in sorted(set(have) - want, key=lambda w: label.get(w, w)):
        demote(a.machine, have[wid], wid)
        print("  - %s" % label.get(wid, wid))

    if want - set(have):  # name the new tabs once herdr has made them
        names = terminals()
        for wid, tab in current(space(space_name), names).items():
            want_name = label.get(wid)
            if want_name and tab.get("name") != want_name:
                rename(tab["id"], want_name)
    print("  %d managed" % len(want))


if __name__ == "__main__":
    main()
