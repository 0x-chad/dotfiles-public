#!/usr/bin/env python3
"""Choose which tmux windows herdr shows, from the machine the windows live on.

  herdr-manage show <session>:<window>   show the window in herdr
  herdr-manage hide <session>:<window>   hide it from herdr; the agent keeps running
  herdr-manage list [session]            windows and whether herdr shows them

<window> is a name or an @id, looked up only inside <session>. To control
another machine, run this script there:  ssh <machine> herdr-manage show s:w

A herdr space is a tmux session and a tab is a window. Showing a window makes a
one-window tmux session (herdr-view-<id>) that links it, plus an hc terminal
attached to that view, labelled so muxlight can find it. The space and tab go
into herdr's layout, which this machine's core keeps (the "herdr-app"
document), named after the session and the window. Names someone set in herdr
are left alone. herdr-agent creates the same shape for agents started from
herdr.
"""
import json
import os
import re
import secrets
import subprocess
import sys
import time

HC = os.environ.get("HC", os.path.expanduser("~/.local/bin/hc"))
HOME = os.path.expanduser("~")
PREFIX = "herdr-view-"
LAYOUT = "herdr-app"
WINDOW_FORMAT = "#{window_id}|#{session_name}|#{window_name}"


def die(message):
    print("herdr-manage: " + message, file=sys.stderr)
    sys.exit(1)


def run(*argv, input=None):
    try:
        p = subprocess.run(argv, capture_output=True, text=True, input=input)
    except FileNotFoundError:
        return 127, "", argv[0] + " not found"
    return p.returncode, p.stdout, p.stderr


def tmux(*args):
    return run("tmux", *args)[1]


# ── tmux ────────────────────────────────────────────────────────────

def windows(session=None):
    """(id, session, name) for the windows of one session, or of every session.
    The view sessions' own links are left out."""
    if session:
        out = tmux("list-windows", "-t", "=" + session, "-F", WINDOW_FORMAT)
    else:
        out = tmux("list-windows", "-a", "-F", WINDOW_FORMAT)
    rows = [line.split("|", 2) for line in out.splitlines() if line]
    return [r for r in rows if not r[1].startswith(PREFIX)]


def resolve(target):
    """"session:window" -> (id, session, name). The window is a name or an @id."""
    session, sep, window = target.partition(":")
    if not (sep and session and window):
        die("'%s' needs a session: <session>:<window>" % target)
    if run("tmux", "has-session", "-t", "=" + session)[0]:
        die("no tmux session '%s'" % session)
    hits = [w for w in windows(session) if window in (w[0], w[2])]
    if not hits:
        die("no window '%s' in session '%s'" % (window, session))
    if len(hits) > 1:
        die("'%s' matches %d windows in '%s'; use the @id" % (window, len(hits), session))
    return hits[0]


# ── hc terminals ────────────────────────────────────────────────────

def terminals(*args):
    code, out, _ = run(HC, "ls", "--json", *args)
    try:
        return json.loads(out).get("terminals", []) if code == 0 else []
    except ValueError:
        return []


def terminal_for(num):
    """The address of the terminal showing window @num, or None."""
    found = terminals("--label", "herdr.window=" + num)
    return found[0]["address"] if found else None


def links(view, wid):
    """Whether the view session holds this window (not a restored copy)."""
    return wid in tmux("list-windows", "-t", "=" + view, "-F", "#{window_id}").split()


def attached(address, view, wid):
    """Whether the terminal is running `tmux attach` to a view of this window."""
    code, out, _ = run(HC, "get", address, "--json")
    try:
        record = json.loads(out) if code == 0 else {}
    except ValueError:
        return False
    argv = (record.get("foreground") or {}).get("argv") or []
    return argv[:2] == ["tmux", "attach"] and view in argv and links(view, wid)


def terminal_name(window, num):
    """hc names are 1-32 of a-z 0-9 - _ and unique among live terminals: the
    window name made legal, with the window id added if it's taken."""
    base = re.sub(r"[^a-z0-9_-]+", "-", window.lower()).strip("-_")[:28] or "window"
    taken = {t["name"] for t in terminals()}
    return base if base not in taken else ("%s-%s" % (base[:24], num))[:32]


# ── herdr's layout ──────────────────────────────────────────────────

def rpc(method, params):
    request = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params})
    _, out, _ = run(HC, "connect", input=request + "\n")
    for line in out.splitlines():
        try:
            message = json.loads(line)
        except ValueError:
            continue
        if message.get("id") == 1:
            return message
    die("no reply from hc connect (%s)" % method)


def read_layout():
    got = rpc("doc.get", {"name": LAYOUT})
    if "error" in got:
        die("cannot read herdr's layout: %s" % got["error"].get("message"))
    return got["result"]


def edit_layout(change):
    """Apply change(layout), which returns whether it changed anything. The
    write only lands if herdr hasn't written in between; otherwise read again."""
    for _ in range(10):
        current = read_layout()
        layout = current.get("value") or {"spaces": []}
        if not change(layout):
            return
        put = rpc("doc.set", {"name": LAYOUT, "version": current["version"], "value": layout})
        if "error" not in put:
            return
        if (put["error"].get("data") or {}).get("kind") != "conflict":
            die("cannot write herdr's layout: %s" % put["error"].get("message"))
        time.sleep(0.2)
    die("herdr's layout kept changing; try again")


def panes(node):
    """Terminal addresses under a layout node."""
    found = []
    terminal = (node.get("content") or {}).get("terminal")
    if terminal:
        found.append(terminal)
    for child in node.get("children", []):
        found += panes(child)
    return found


def space_id(session):
    """The id of the space named after this session, or a new one."""
    for space in (read_layout().get("value") or {}).get("spaces", []):
        if space.get("name") == session:
            return space["id"]
    return "spe" + secrets.token_hex(16)


def place(space, session, folder, window, address):
    """Make sure `address` is a tab named after the window, in a space named
    after the session. With space None, only names what herdr already placed."""
    def change(layout):
        spaces = layout.setdefault("spaces", [])
        holder = next((s for s in spaces if address in panes_of(s)), None)
        target = holder or next((s for s in spaces if s["id"] == space), None)
        changed = False
        if target is None:
            if space is None:
                return False
            target = {"folder": folder, "id": space, "name": session, "tabs": []}
            spaces.append(target)
            changed = True
        elif not target.get("name"):
            target["name"] = session
            changed = True
        tab = next((t for t in target["tabs"] if address in panes(t["root"])), None)
        if tab is None:
            tab_id = "tb" + secrets.token_hex(16)
            target["tabs"].append({
                "id": tab_id,
                "name": window,
                "root": {"children": [{"content": {"terminal": address},
                                       "id": "p" + secrets.token_hex(16), "type": "block"}],
                         "id": tab_id, "type": "row"},
            })
            changed = True
        elif not tab.get("name"):
            tab["name"] = window
            changed = True
        return changed
    edit_layout(change)


def panes_of(space):
    return [a for tab in space.get("tabs", []) for a in panes(tab["root"])]


def prune(node, address):
    """Drop `address`'s pane under node; return whether node is left empty."""
    kept = []
    for child in node.get("children", []):
        if (child.get("content") or {}).get("terminal") == address:
            continue
        if "children" in child and prune(child, address):
            continue
        kept.append(child)
    node["children"] = kept
    return not kept


def unplace(address):
    """Take `address` out of the layout; an emptied tab or space goes with it."""
    def change(layout):
        changed = False
        for space in list(layout.get("spaces", [])):
            for tab in list(space.get("tabs", [])):
                if address in panes(tab["root"]):
                    changed = True
                    if prune(tab["root"], address):
                        space["tabs"].remove(tab)
            if changed and not space["tabs"]:
                layout["spaces"].remove(space)
        return changed
    edit_layout(change)


def hide_status(view):
    # herdr shows its own tab names; the view's tmux status bar only costs a row.
    tmux("set-option", "-t", view, "status", "off")


# ── commands ────────────────────────────────────────────────────────

def show(target):
    wid, session, window = resolve(target)
    num = wid.lstrip("@")
    folder = tmux("display-message", "-p", "-t", wid, "#{pane_current_path}").strip() or HOME

    view = PREFIX + num
    address = terminal_for(num)
    if address and attached(address, view, wid):
        hide_status(view)
        place(None, session, folder, window, address)
        print("%s already in herdr as %s" % (window, address))
        return
    if address:
        # Left from before a reboot or tmux restart: a bare shell, or a view
        # that no longer links this window. Replace it.
        run(HC, "kill", address)
        run(HC, "rm", address)
        unplace(address)

    space = space_id(session)
    if not links(view, wid):
        tmux("kill-session", "-t", "=" + view)
        placeholder = tmux("new-session", "-d", "-s", view, "-n", "__view_placeholder",
                           "-P", "-F", "#{window_id}").strip()
        tmux("link-window", "-s", wid, "-t", view + ":90")
        if placeholder:
            tmux("kill-window", "-t", placeholder)
    hide_status(view)

    name = terminal_name(window, num)
    code, out, err = run(HC, "run", "--bg", "--name", name, "--cwd", folder,
                         "--label", "herdr.space=" + space, "--label", "herdr.window=" + num,
                         "tmux", "attach", "-t", view)
    if code:
        die("hc run failed for '%s': %s" % (name, (err or out).strip()[:300]))
    # hc can drop a run without saying so; confirm the terminal exists.
    for _ in range(10):
        address = terminal_for(num)
        if address:
            break
        time.sleep(1)
    if not address:
        tmux("kill-session", "-t", "=" + view)
        die("hc did not create a terminal for '%s'" % name)

    place(space, session, folder, window, address)

    # muxlight reports on change; publish the current state so the tab is right now.
    first = tmux("list-panes", "-t", wid, "-F", "#{@pst_state}|#{@pst_kind}|#{@pst_app}").splitlines()
    state, kind, app = (first[0].split("|") + ["", "", ""])[:3] if first else ("", "", "")
    if state:
        body = "state=" + state + (":kind=" + kind if kind else "") + (":app=" + app if app else "")
        run(HC, "report", body, "--terminal", address)
    print("%s shown as %s in space %s" % (name, address, session))


def hide(target):
    wid, _, window = resolve(target)
    num = wid.lstrip("@")
    address = terminal_for(num)
    if not address:
        print("%s is not shown in herdr" % window)
        return
    run(HC, "kill", address)
    run(HC, "rm", address)
    tmux("kill-session", "-t", "=" + PREFIX + num)
    unplace(address)
    print("%s hidden; the agent is still running" % window)


def list_windows(session=None):
    for wid, session_name, window in windows(session):
        address = terminal_for(wid.lstrip("@"))
        print("%-6s %-28s %s" % (wid, session_name + ":" + window, address or "not in herdr"))


def main(argv):
    usage = "\n".join(__doc__.splitlines()[:6])
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(usage)
        return
    if run("tmux", "-V")[0]:
        die("tmux not found")
    if not os.access(HC, os.X_OK):
        die("hc not found at " + HC)
    command, args = argv[0], argv[1:]
    if command in ("show", "hide"):
        if not args:
            die("usage: herdr-manage %s <session>:<window>" % command)
        for target in args:
            (show if command == "show" else hide)(target)
    elif command == "list":
        list_windows(args[0] if args else None)
    else:
        print(usage, file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
