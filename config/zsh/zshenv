typeset -U path PATH

[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
export PATH="/usr/local/bin:$PATH"
export PATH="$HOME/bin:$PATH"
export PATH="$HOME/scripts:$PATH"
export PATH="$HOME/.local/bin:$PATH"
# Bound agent-browser daemon lifetime, including external CDP sessions.
export AGENT_BROWSER_IDLE_TIMEOUT_MS="14400000"
# Load secrets (not tracked in git)
[[ -f ~/.secrets ]] && source ~/.secrets

# CLIProxyAPI is configured as the default codex provider by
# scripts/setup-cliproxyapi.sh. Exported here rather than in .zshrc so that
# non-interactive shells (scripts, cron, `codex exec`) inherit it too.
for _cliproxy_env in "$HOME/.config/cliproxyapi/client.env" "$HOME/.cli-proxy-api/client.env"; do
  [[ -r "$_cliproxy_env" ]] || continue
  export CLIPROXY_API_KEY="${$(<"$_cliproxy_env")#CLIPROXY_API_KEY=}"
  break
done
unset _cliproxy_env
