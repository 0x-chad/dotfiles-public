history() { builtin fc -l 1 "$@"; }

### --- Login-only bootstrap (runs only in login shells) ---
if [[ -o login ]]; then
  # Homebrew
  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi

  # pyenv --path belongs in login shell
  export PATH="$HOME/.pyenv/bin:$PATH"
  command -v pyenv >/dev/null 2>&1 && eval "$(pyenv init --path --no-rehash)"
fi

### --- Common PATH & tools ---

# Go
export GOPATH="$HOME/go"
export PATH="$PATH:$GOPATH/bin"

# Poetry / local Python tools
export PATH="$HOME/.local/bin:$PATH"

# Foundry & Rust
export PATH="$PATH:$HOME/.foundry/bin"
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Yarn global bin
if command -v yarn >/dev/null 2>&1; then
  export PATH="$(yarn global bin):$PATH"
fi

### --- Prompt & colors ---
autoload -U colors && colors
# %n = username, %1~ = last path segment, %F{color} sets color, %f resets
PROMPT="%F{magenta}%n@%m:%1~ $ %f"

### --- Aliases ---
alias codex='codex --dangerously-bypass-approvals-and-sandbox'
alias claude='claude --dangerously-skip-permissions --chrome'
alias claude-fast='ccr code --dangerously-skip-permissions'
alias python=python3
alias pip=pip3
gws() {
  if [[ "$#" -eq 1 && ( "$1" == "setup-help" || "$1" == "help" || "$1" == "--help" || "$1" == "-h" ) ]]; then
    cat <<'EOF'
Set up one wrapper per Google account in your private/local shell config:

  gws_account_name() {
    GOOGLE_WORKSPACE_CLI_CONFIG_DIR="$HOME/.config/gws-account_name" command gws "$@"
  }

Replace account_name with an identifier you use and repeat for each account.
Each wrapper should use a separate config directory and credentials.
Then invoke the wrapper instead of bare `gws`.
EOF
    return 0
  fi

  cat >&2 <<'EOF'
The bare gws command is disabled because it has no account context.

Run `gws setup-help` for generic multi-account setup instructions.
EOF
  return 64
}

### --- pyenv (interactive shell part) ---
if command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init - --no-rehash)"
fi

### --- Node (fnm - fast node manager) ---
if command -v fnm >/dev/null 2>&1; then
  path=(${path:#$HOME/.local/state/fnm_multishells/*/bin})
  unset FNM_MULTISHELL_PATH
  eval "$(fnm env --use-on-cd)"
fi

### --- tmux environment sync ---
if [[ -n "$TMUX" ]] && command -v tmux >/dev/null 2>&1; then
  tmux set-environment -g PATH "$PATH" 2>/dev/null || true
fi

### --- History (zsh way) ---
export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=100000
export SAVEHIST=100000
setopt APPEND_HISTORY          # append rather than overwrite
setopt INC_APPEND_HISTORY      # write as commands are issued
setopt SHARE_HISTORY           # share across sessions
setopt HIST_IGNORE_DUPS        # ignore duplicate commands
setopt HIST_REDUCE_BLANKS      # trim extra spaces

### --- grep color (GREP_OPTIONS deprecated) ---
export GREP_COLORS="mt=1;35;40"
alias grep='grep --color=always'

### --- Completion & fzf ---
autoload -Uz compinit && compinit
if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --zsh 2>/dev/null)" || source <(fzf --completion zsh 2>/dev/null) || true
fi
# If you use fzf-tab for zsh:
# source ~/fzf-tab-completion/zsh/fzf-zsh-completion.zsh

